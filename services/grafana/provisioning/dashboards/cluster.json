    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Hosts available vs. in use",
            "datasource": {
                "type": "yesoreyeram-infinity-datasource",
                "uid": "df5tfgbpfeakgc"
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 10
            },
            "targets": [
                {
                    "refId": "A",
                    "type": "json",
                    "source": "url",
                    "parser": "backend",
                    "format": "table",
                    "url": "http://api:8000/api/cluster?start=${__from:date:iso}&end=${__to:date:iso}",
                    "url_options": {
                        "method": "GET"
                    },
                    "root_selector": "data",
                    "columns": [
                        {
                            "selector": "timestamp",
                            "text": "timestamp",
                            "type": "timestamp"
                        },
                        {
                            "selector": "hosts_up",
                            "text": "Available",
                            "type": "number"
                        },
                        {
                            "selector": "tasks_active",
                            "text": "In use",
                            "type": "number"
                        }
                    ]
                }
            ],
            "transformations": [
                {
                    "id": "organize",
                    "options": {
                        "indexByName": {
                            "Available": 0,
                            "In use": 1
                        }
                    }
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "custom": {
                        "axisLabel": "Hosts",
                        "lineWidth": 2,
                        "showPoints": "never"
                    },
                    "unit": "locale"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Available"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#338ec1"
                                }
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "In use"
                        },
                        "properties": [
                            {
                                "id": "color",
                                "value": {
                                    "mode": "fixed",
                                    "fixedColor": "#E69F00"
                                }
                            }
                        ]
                    }
                ]
            },
            "options": {
                "tooltip": {
                    "mode": "multi"
                }
            }
        },
