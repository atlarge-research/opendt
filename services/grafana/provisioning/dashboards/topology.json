                        "kind": "QueryGroup",
                        "spec": {
                            "queries": [],
                            "transformations": [],
                            "queryOptions": {}
                        }
                    },
                    "vizConfig": {
                        "kind": "VizConfig",
                        "group": "text",
                        "version": "",
                        "spec": {
                            "options": {
                                "mode": "markdown",
                                "content": "[Detailed](/d/opendt-overview?${__url_time_range}) · [Simple](/d/opendt-simple?${__url_time_range}) · **Topology**"
                            },
                            "fieldConfig": {
                                "defaults": {},
                                "overrides": []
                            }
                        }
                    }
                }
            },
            "servers": {
                "kind": "Panel",
                "spec": {
                    "id": 2,
                    "title": "Servers",
                    "description": "",
                    "links": [],
                    "data": {
                        "kind": "QueryGroup",
                        "spec": {
                            "queries": [],
                            "transformations": [],
                            "queryOptions": {}
                        }
                    },
                    "vizConfig": {
                        "kind": "VizConfig",
                        "group": "volkovlabs-form-panel",
                        "version": "",
                        "spec": {
                            "options": {
                                "initial": {
                                    "method": "GET",
                                    "url": "http://localhost:3001/api/status"
                                },
                                "update": {
                                    "method": "PATCH",
                                    "url": "http://localhost:3001/api/control",
                                    "payloadMode": "updated",
                                    "confirm": true,
                                    "code": "const response = context.panel.response;\nif (response && response.ok) {\n  context.grafana.notifySuccess(['Servers', 'Sent to the twin']);\n} else {\n  context.grafana.notifyError(['Servers', `The API answered ${response && response.status}`]);\n}"
                                },
                                "sync": false,
                                "elements": [
                                    {
                                        "uid": "kind_1",
                                        "id": "kind_1",
                                        "title": "Servers 1",
                                        "type": "select",
                                        "labelWidth": 12,
                                        "options": [
                                            {
                                                "id": "H01",
                                                "label": "SURF (16 cores)",
                                                "value": "H01"
                                            },
                                            {
                                                "id": "EPYC",
                                                "label": "EPYC (64 cores)",
                                                "value": "EPYC"
                                            },
                                            {
                                                "id": "Xeon",
                                                "label": "Xeon (40 cores)",
                                                "value": "Xeon"
                                            },
                                            {
                                                "id": "Memory",
                                                "label": "Memory, 1 TiB (48 cores)",
                                                "value": "Memory"
                                            },
                                            {
                                                "id": "Edge",
                                                "label": "Edge (8 cores)",
                                                "value": "Edge"
                                            }
                                        ]
                                    },
                                    {
                                        "uid": "count_1",
                                        "id": "count_1",
                                        "title": "Count",
                                        "type": "number",
                                        "labelWidth": 12,
                                        "min": 0
                                    },
                                    {
                                        "uid": "kind_2",
                                        "id": "kind_2",
                                        "title": "Servers 2",
                                        "type": "select",
                                        "labelWidth": 12,
                                        "options": [
                                            {
                                                "id": "H01",
                                                "label": "SURF (16 cores)",
                                                "value": "H01"
                                            },
                                            {
                                                "id": "EPYC",
                                                "label": "EPYC (64 cores)",
                                                "value": "EPYC"
                                            },
                                            {
                                                "id": "Xeon",
                                                "label": "Xeon (40 cores)",
                                                "value": "Xeon"
                                            },
                                            {
                                                "id": "Memory",
                                                "label": "Memory, 1 TiB (48 cores)",
                                                "value": "Memory"
                                            },
                                            {
                                                "id": "Edge",
                                                "label": "Edge (8 cores)",
                                                "value": "Edge"
                                            }
                                        ]
                                    },
                                    {
                                        "uid": "count_2",
                                        "id": "count_2",
                                        "title": "Count",
                                        "type": "number",
                                        "labelWidth": 12,
                                        "min": 0
                                    },
                                    {
                                        "uid": "kind_3",
                                        "id": "kind_3",
                                        "title": "Servers 3",
                                        "type": "select",
                                        "labelWidth": 12,
                                        "options": [
                                            {
                                                "id": "H01",
                                                "label": "SURF (16 cores)",
                                                "value": "H01"
                                            },
                                            {
                                                "id": "EPYC",
                                                "label": "EPYC (64 cores)",
                                                "value": "EPYC"
                                            },
                                            {
                                                "id": "Xeon",
                                                "label": "Xeon (40 cores)",
                                                "value": "Xeon"
                                            },
                                            {
                                                "id": "Memory",
                                                "label": "Memory, 1 TiB (48 cores)",
                                                "value": "Memory"
                                            },
                                            {
                                                "id": "Edge",
                                                "label": "Edge (8 cores)",
                                                "value": "Edge"
                                            }
                                        ],
                                        "showIf": "return context.panel.elements.find((e) => e.id === 'kind_2').value"
                                    },
                                    {
                                        "uid": "count_3",
                                        "id": "count_3",
                                        "title": "Count",
                                        "type": "number",
                                        "labelWidth": 12,
                                        "min": 0,
                                        "showIf": "return context.panel.elements.find((e) => e.id === 'kind_2').value"
                                    }
                                ],
                                "submit": {
                                    "text": "Apply"
                                },
                                "reset": {
                                    "text": "Full screen",
                                    "icon": "monitor",
                                    "variant": "secondary"
                                },
                                "resetAction": {
                                    "mode": "custom",
                                    "code": "document.documentElement.requestFullscreen();\ncontext.grafana.locationService.partial({ kiosk: true });",
                                    "confirm": false
                                },
                                "confirmModal": {
                                    "title": "Change the twin",
                                    "body": "The twin changes from its next window of operation.",
                                    "columns": {
                                        "name": "",
                                        "oldValue": "Now",
                                        "newValue": "New"
                                    },
                                    "confirm": "Apply"
                                }
                            },
                            "fieldConfig": {
                                "defaults": {},
                                "overrides": []
                            }
                        }
                    }
                }
