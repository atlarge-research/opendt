{
    "apiVersion": "dashboard.grafana.app/v2beta1",
    "kind": "Dashboard",
    "metadata": {
        "name": "opendt-topology"
    },
    "spec": {
        "title": "OpenDT, topology",
        "description": "",
        "tags": [
            "opendt"
        ],
        "cursorSync": "Crosshair",
        "editable": true,
        "liveNow": false,
        "preload": false,
        "links": [],
