            {
                "kind": "AnnotationQuery",
                "spec": {
                    "name": "Topology changes",
                    "enable": true,
                    "hide": false,
                    "iconColor": "#D55E00",
                    "query": {
                        "kind": "DataQuery",
                        "group": "yesoreyeram-infinity-datasource",
                        "version": "v0",
                        "datasource": {
                            "name": "df5tfgbpfeakgc"
                        },
                        "spec": {
                            "type": "json",
                            "source": "url",
                            "parser": "backend",
                            "format": "table",
                            "url": "http://api:8000/api/events",
                            "url_options": {
                                "method": "GET"
                            },
                            "root_selector": "data",
                            "columns": [
                                {
                                    "selector": "time",
                                    "text": "time",
                                    "type": "timestamp"
                                },
                                {
                                    "selector": "text",
                                    "text": "text",
                                    "type": "string"
                                }
                            ]
                        }
                    }
                }
            }
        ],
        "elements": {
            "screens-topology": {
                "kind": "Panel",
                "spec": {
                    "id": 1,
                    "title": "",
                    "description": "",
                    "links": [],
