            "hosts-topology": {
                "kind": "Panel",
                "spec": {
                    "id": 5,
                    "title": "Hosts available vs. in use",
                    "description": "",
                    "links": [],
                    "data": {
                        "kind": "QueryGroup",
                        "spec": {
                            "queries": [
                                {
                                    "kind": "PanelQuery",
                                    "spec": {
                                        "refId": "A",
                                        "hidden": false,
                                        "query": {
                                            "kind": "DataQuery",
                                            "group": "yesoreyeram-infinity-datasource",
                                            "version": "v0",
                                            "datasource": {
                                                "name": "df5tfgbpfeakgc"
                                            },
                                            "spec": {
                                                "type": "json",
                                                "source": "url",
                                                "parser": "backend",
                                                "format": "table",
                                                "url": "http://api:8000/api/cluster?start=${__from:date:iso}&end=${__to:date:iso}",
                                                "url_options": {
                                                    "method": "GET"
                                                },
                                                "root_selector": "data",
                                                "columns": [
                                                    {
                                                        "selector": "timestamp",
                                                        "text": "timestamp",
                                                        "type": "timestamp"
                                                    },
                                                    {
                                                        "selector": "hosts_up",
                                                        "text": "Available",
                                                        "type": "number"
                                                    },
                                                    {
                                                        "selector": "hosts_in_use",
                                                        "text": "In use",
                                                        "type": "number"
                                                    }
                                                ]
                                            }
                                        }
                                    }
                                }
                            ],
                            "transformations": [
                                {
                                    "kind": "organize",
                                    "spec": {
                                        "id": "organize",
                                        "options": {
                                            "indexByName": {
                                                "Available": 0,
                                                "In use": 1
                                            }
                                        }
                                    }
                                }
                            ],
                            "queryOptions": {}
                        }
                    },
                    "vizConfig": {
                        "kind": "VizConfig",
                        "group": "timeseries",
                        "version": "",
                        "spec": {
                            "options": {
                                "legend": {
                                    "calcs": [
                                        "lastNotNull"
                                    ]
                                },
                                "tooltip": {
                                    "mode": "multi"
                                }
                            },
                            "fieldConfig": {
                                "defaults": {
                                    "min": 0,
                                    "custom": {
                                        "axisLabel": "Hosts",
                                        "lineWidth": 2,
                                        "showPoints": "never"
                                    },
                                    "unit": "locale"
                                },
                                "overrides": [
                                    {
                                        "matcher": {
                                            "id": "byName",
                                            "options": "Available"
